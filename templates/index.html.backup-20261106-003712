<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>SNMP Network Dashboard</title>
<style>
:root {
  color-scheme: dark;
  --bg:#080b10; --panel:#111722; --panel2:#172130;
  --line:#293548; --text:#f4f7fb; --muted:#b5c0d0;
  --yellow:#ffd84d; --green:#55dc91; --red:#ff7272; --blue:#76baff;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
  font:18px/1.5 Arial, sans-serif}
header{padding:22px 28px;background:#101722;border-bottom:1px solid var(--line)}
h1{font-size:30px;margin:0 0 4px}
.sub{color:var(--muted);font-size:16px}
main{padding:24px;max-width:1800px;margin:auto}
.cards{display:grid;grid-template-columns:repeat(3,minmax(240px,1fr));gap:16px}
.card,.panel{background:var(--panel);border:1px solid var(--line);
  border-radius:12px;padding:20px}
.card{cursor:pointer;text-align:left;color:var(--text);font:inherit}
.card.selected{border:2px solid var(--yellow);padding:19px}
.card h2{font-size:22px;margin:0 0 10px}
.status{font-weight:bold}
.online{color:var(--green)} .offline{color:var(--red)}
.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:15px}
.metric{background:var(--panel2);padding:12px;border-radius:8px}
.metric span{display:block;color:var(--muted);font-size:14px}
.metric strong{font-size:22px}
section{margin-top:22px}
.section-head{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
h2{font-size:23px;margin:0 0 12px}
h3{font-size:19px;margin:0 0 12px}
.info{color:var(--muted);font-size:16px}
table{width:100%;border-collapse:collapse;min-width:850px}
th,td{padding:13px 12px;text-align:left;border-bottom:1px solid var(--line)}
th{background:#1a2636;color:var(--yellow);font-size:15px;position:sticky;top:0}
td{font-size:16px}
.table-wrap{overflow-x:auto;border:1px solid var(--line);border-radius:9px}
.up{color:var(--green);font-weight:bold}.down{color:var(--red);font-weight:bold}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}
.tabs button{background:var(--panel2);color:var(--text);border:1px solid var(--line);
  padding:11px 20px;border-radius:8px;font-size:17px;cursor:pointer}
.tabs button.active{background:var(--yellow);color:#111;font-weight:bold}
.hidden{display:none}
#updated{color:var(--muted);font-size:14px}
@media(max-width:850px){.cards{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr)}main{padding:14px}header{padding:18px}}
</style>
</head>
<body>
<header>
  <h1>SNMP Network Dashboard</h1>
  <div class="sub">Cisco switch monitoring · Auto refresh every {{ refresh }} seconds</div>
</header>
<main>
  <div class="section-head">
    <h2>Switch overview</h2><span id="updated">Waiting for SNMP data…</span>
  </div>
  <div class="cards" id="cards"></div>

  <section class="panel">
    <div class="section-head">
      <div><h2 id="detail-title">Switch details</h2><div class="info" id="device-info"></div></div>
      <div class="info" id="device-location"></div>
    </div>
    <div class="metrics" id="metrics"></div>
    <div class="tabs">
      <button class="active" data-tab="interfaces">Interfaces</button>
      <button data-tab="vlans">VLANs</button>
      <button data-tab="macs">MAC address table</button>
    </div>
    <div id="interfaces" class="tab-content">
      <div class="table-wrap"><table>
        <thead><tr><th>Interface</th><th>Description</th><th>Status</th>
        <th>Speed</th><th>RX Mbps</th><th>TX Mbps</th><th>RX errors</th><th>TX errors</th></tr></thead>
        <tbody id="interface-rows"></tbody>
      </table></div>
    </div>
    <div id="vlans" class="tab-content hidden">
      <div class="table-wrap"><table><thead><tr><th>VLAN ID</th><th>Name</th></tr></thead>
      <tbody id="vlan-rows"></tbody></table></div>
    </div>
    <div id="macs" class="tab-content hidden">
      <div class="table-wrap"><table><thead><tr><th>MAC address</th><th>Bridge port</th><th>Interface</th><th>Status</th></tr></thead>
      <tbody id="mac-rows"></tbody></table></div>
    </div>
  </section>
</main>
<script>
let selected = "switch-1";
let latest = [];

function esc(v) {
  return String(v ?? "").replace(/[&<>"']/g, c =>
    ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
}
function fmt(v) {
  if (v === null || v === undefined) return "—";
  return Number(v).toLocaleString();
}
function render(data) {
  latest = data.switches || [];
  if (!latest.some(s => s.id === selected) && latest.length) selected = latest[0].id;

  document.getElementById("cards").innerHTML = latest.map(s => `
    <button class="card ${s.id === selected ? "selected" : ""}" data-id="${esc(s.id)}">
      <h2>${esc(s.name)}</h2>
      <div class="status ${s.online ? "online" : "offline"}">
        ${s.online ? "● ONLINE" : "● OFFLINE"}
      </div>
      <div class="sub">${esc(s.host)} · ${fmt(s.interface_count)} interfaces</div>
      <div class="metrics">
        <div class="metric"><span>CPU</span><strong>${s.cpu === null ? "—" : fmt(s.cpu) + "%"}</strong></div>
        <div class="metric"><span>Memory</span><strong>${s.memory_percent === null ? "—" : fmt(s.memory_percent) + "%"}</strong></div>
        <div class="metric"><span>Uptime</span><strong style="font-size:15px">${esc(s.uptime)}</strong></div>
      </div>
    </button>`).join("");

  document.querySelectorAll(".card").forEach(b =>
    b.addEventListener("click", () => { selected = b.dataset.id; render({switches:latest}); }));

  const s = latest.find(x => x.id === selected);
  if (!s) return;
  document.getElementById("detail-title").textContent = s.name + " · Details";
  document.getElementById("device-info").textContent = s.sys_descr || s.last_error || "";
  document.getElementById("device-location").textContent = s.location || "";
  document.getElementById("metrics").innerHTML = `
    <div class="metric"><span>CPU average</span><strong>${s.cpu === null ? "—" : fmt(s.cpu)+"%"}</strong></div>
    <div class="metric"><span>Memory used</span><strong>${s.memory_used === null ? "—" : fmt(s.memory_used)+" bytes"}</strong></div>
    <div class="metric"><span>Memory free</span><strong>${s.memory_free === null ? "—" : fmt(s.memory_free)+" bytes"}</strong></div>`;
  document.getElementById("interface-rows").innerHTML = (s.interfaces || []).map(i => `
    <tr>
      <td><strong>${esc(i.name)}</strong></td><td>${esc(i.alias || i.description)}</td>
      <td class="${i.oper === 1 ? "up" : "down"}">${i.oper === 1 ? "UP" : "DOWN"}</td>
      <td>${fmt(i.speed_mbps)} Mbps</td><td>${fmt(i.rx_mbps)}</td><td>${fmt(i.tx_mbps)}</td>
      <td>${fmt(i.in_errors)}</td><td>${fmt(i.out_errors)}</td>
    </tr>`).join("") || `<tr><td colspan="8">No interface data</td></tr>`;
  document.getElementById("vlan-rows").innerHTML = (s.vlans || []).map(v =>
    `<tr><td>${esc(v.id)}</td><td>${esc(v.name)}</td></tr>`).join("") ||
    `<tr><td colspan="2">No VLAN data</td></tr>`;
  document.getElementById("mac-rows").innerHTML = (s.macs || []).map(m =>
    `<tr><td>${esc(m.mac)}</td><td>${esc(m.port)}</td><td>${esc(m.interface)}</td><td>${m.status === 3 ? "Learned" : fmt(m.status)}</td></tr>`).join("") ||
    `<tr><td colspan="4">No MAC entries</td></tr>`;
  document.getElementById("updated").textContent = "Last update: " + new Date().toLocaleTimeString();
}
document.querySelectorAll(".tabs button").forEach(b => b.addEventListener("click", () => {
  document.querySelectorAll(".tabs button").forEach(x => x.classList.remove("active"));
  document.querySelectorAll(".tab-content").forEach(x => x.classList.add("hidden"));
  b.classList.add("active");
  document.getElementById(b.dataset.tab).classList.remove("hidden");
}));
async function refresh() {
  try {
    const r = await fetch("/api/data", {cache:"no-store"});
    render(await r.json());
  } catch(e) {
    document.getElementById("updated").textContent = "Dashboard API unavailable";
  }
}
refresh();
setInterval(refresh, {{ refresh * 1000 }});
</script>
</body>
</html>
