<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Switch Monitor</title>
<style>
:root {
 --bg:#090d14;--surface:#111925;--surface2:#182333;
 --border:#29374a;--text:#edf3fa;--muted:#a7b5c7;
 --accent:#f3ca55;--green:#4bd69a;--red:#ff707b;--blue:#75baff;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);
 font:17px/1.5 Arial,sans-serif}
header{height:76px;border-bottom:1px solid var(--border);
 display:flex;align-items:center;justify-content:space-between;
 padding:0 32px;background:#0e1520}
.brand{font-size:22px;font-weight:700;letter-spacing:.3px}
.brand span{color:var(--accent)}
.header-right{display:flex;align-items:center;gap:20px;color:var(--muted);font-size:14px}
main{max-width:1600px;margin:auto;padding:28px}
nav{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:26px}
nav a{padding:11px 22px;background:var(--surface);border:1px solid var(--border);
 border-radius:8px;color:var(--muted);text-decoration:none;font-weight:600}
nav a.active{background:var(--accent);color:#171717;border-color:var(--accent)}
.heading{display:flex;justify-content:space-between;align-items:center;
 gap:16px;flex-wrap:wrap;margin-bottom:20px}
h1{font-size:30px;margin:0}
h2{font-size:21px;margin:0 0 18px}
h3{font-size:17px;margin:0}
.muted{color:var(--muted)}
.status{font-weight:700;display:flex;align-items:center;gap:9px}
.dot{width:10px;height:10px;border-radius:50%;background:var(--red)}
.dot.online{background:var(--green);box-shadow:0 0 10px #4bd69a66}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
.panel{background:var(--surface);border:1px solid var(--border);
 border-radius:10px;padding:20px}
.metric-label{color:var(--muted);font-size:15px;margin-bottom:8px}
.metric-value{font-size:28px;font-weight:700;overflow-wrap:anywhere}
.metric-sub{font-size:13px;color:var(--muted);margin-top:5px}
.content{margin-top:22px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}
.tabs button{border:1px solid var(--border);background:var(--surface2);
 color:var(--muted);padding:11px 22px;border-radius:7px;
 font-size:16px;font-weight:600;cursor:pointer}
.tabs button.active{background:var(--accent);color:#171717;border-color:var(--accent)}
.table-wrap{overflow:auto;border:1px solid var(--border);border-radius:8px}
table{width:100%;border-collapse:collapse;min-width:760px}
th{background:#1a2738;color:var(--accent);font-size:14px;text-align:left;
 padding:15px 14px;white-space:nowrap}
td{padding:14px;border-top:1px solid var(--border);white-space:nowrap}
tr:hover td{background:#172232}
.up{color:var(--green);font-weight:700}
.down{color:var(--red);font-weight:700}
.tab-content.hidden{display:none}
.device-info{margin-top:8px;color:var(--muted);font-size:15px}
.toolbar{display:flex;justify-content:space-between;align-items:center;
 gap:12px;flex-wrap:wrap;margin-bottom:14px}
input{background:var(--surface2);border:1px solid var(--border);
 color:var(--text);padding:11px 14px;border-radius:7px;
 font-size:16px;min-width:230px}
.empty{padding:24px;color:var(--muted)}
footer{text-align:center;padding:24px;color:var(--muted);font-size:13px}
@media(max-width:950px){.grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){
 header{padding:0 16px;height:65px}.header-right{display:none}
 main{padding:18px 12px}h1{font-size:25px}
 .grid{grid-template-columns:1fr 1fr}.metric-value{font-size:23px}
 .panel{padding:15px}
}
</style>
</head>
<body>

<header>
 <div class="brand">NETWORK <span>MONITOR</span></div>
 <div class="header-right">
  <span>SNMP v2c</span>
  <span>Auto refresh: {{ refresh }}s</span>
 </div>
</header>

<main>
 <nav id="switch-nav">
  <a href="/switch/switch-1" data-id="switch-1">SWITCH-1</a>
  <a href="/switch/switch-2" data-id="switch-2">SWITCH-2</a>
  <a href="/switch/switch-3" data-id="switch-3">SWITCH-3</a>
 </nav>

 <div class="heading">
  <div>
   <h1 id="switch-name">Loading switch…</h1>
   <div class="device-info" id="device-description">Retrieving SNMP information</div>
  </div>
  <div class="status">
   <span class="dot" id="status-dot"></span>
   <span id="status-text">CONNECTING</span>
  </div>
 </div>

 <div class="grid">
  <div class="panel">
   <div class="metric-label">CPU UTILIZATION</div>
   <div class="metric-value" id="cpu">—</div>
   <div class="metric-sub">Average processor load</div>
  </div>
  <div class="panel">
   <div class="metric-label">MEMORY UTILIZATION</div>
   <div class="metric-value" id="memory">—</div>
   <div class="metric-sub" id="memory-detail">Used / available</div>
  </div>
  <div class="panel">
   <div class="metric-label">INTERFACES</div>
   <div class="metric-value" id="interface-count">—</div>
   <div class="metric-sub" id="interface-state">Port status</div>
  </div>
  <div class="panel">
   <div class="metric-label">SYSTEM UPTIME</div>
   <div class="metric-value" id="uptime" style="font-size:22px">—</div>
   <div class="metric-sub" id="location">Device location</div>
  </div>
 </div>

 <section class="content panel">
  <div class="tabs">
   <button class="active" data-tab="interfaces">Interfaces</button>
   <button data-tab="vlans">VLANs</button>
   <button data-tab="macs">MAC Address Table</button>
   <button data-tab="device">Device Information</button>
  </div>

  <div id="interfaces" class="tab-content">
   <div class="toolbar">
    <h2>Interface Overview</h2>
    <input id="interface-search" placeholder="Search interfaces…" aria-label="Search interfaces">
   </div>
   <div class="table-wrap">
    <table>
     <thead><tr>
      <th>Interface</th><th>Description</th><th>Status</th>
      <th>Speed</th><th>RX Mbps</th><th>TX Mbps</th>
      <th>RX Errors</th><th>TX Errors</th>
     </tr></thead>
     <tbody id="interface-rows"><tr><td colspan="8">Loading…</td></tr></tbody>
    </table>
   </div>
  </div>

  <div id="vlans" class="tab-content hidden">
   <h2>VLAN Configuration</h2>
   <div class="table-wrap">
    <table><thead><tr><th>VLAN ID</th><th>VLAN Name</th></tr></thead>
    <tbody id="vlan-rows"></tbody></table>
   </div>
  </div>

  <div id="macs" class="tab-content hidden">
   <h2>MAC Address Table</h2>
   <div class="table-wrap">
    <table><thead><tr><th>MAC Address</th><th>Bridge Port</th><th>Interface</th><th>Status</th></tr></thead>
    <tbody id="mac-rows"></tbody></table>
   </div>
  </div>

  <div id="device" class="tab-content hidden">
   <h2>Device Information</h2>
   <div class="table-wrap">
    <table><tbody id="device-rows"></tbody></table>
   </div>
  </div>
 </section>

 <footer>
  SNMP Network Monitor · <span id="last-update">Waiting for data</span>
 </footer>
</main>

<script>
const SWITCH_ID = {{ selected_switch|tojson }};
const REFRESH_MS = {{ refresh * 1000 }};
let currentInterfaces = [];

function esc(v) {
 return String(v ?? "—").replace(/[&<>"']/g,c=>({
  "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"
 }[c]));
}
function fmt(v) {
 return v === null || v === undefined ? "—" : Number(v).toLocaleString();
}
function uptime(v) {
 if (typeof v === "number") {
  const seconds = Math.floor(v / 100);
  const days = Math.floor(seconds / 86400);
  const hours = Math.floor(seconds % 86400 / 3600);
  const mins = Math.floor(seconds % 3600 / 60);
  return `${days}d ${hours}h ${mins}m`;
 }
 return v ?? "—";
}
function renderInterfaces() {
 const q = document.getElementById("interface-search").value.toLowerCase();
 const rows = currentInterfaces.filter(i =>
  `${i.name} ${i.description} ${i.alias}`.toLowerCase().includes(q));
 document.getElementById("interface-rows").innerHTML = rows.map(i=>`
  <tr>
   <td><strong>${esc(i.name)}</strong></td>
   <td>${esc(i.alias || i.description)}</td>
   <td class="${i.oper===1?'up':'down'}">${i.oper===1?'UP':'DOWN'}</td>
   <td>${fmt(i.speed_mbps)} Mbps</td>
   <td>${fmt(i.rx_mbps)}</td><td>${fmt(i.tx_mbps)}</td>
   <td>${fmt(i.in_errors)}</td><td>${fmt(i.out_errors)}</td>
  </tr>`).join("") || '<tr><td colspan="8" class="empty">No matching interfaces</td></tr>';
}
function render(s) {
 document.title = s.name + " · Network Monitor";
 document.getElementById("switch-name").textContent = s.name;
 document.getElementById("device-description").textContent = s.sys_descr || "—";
 document.getElementById("status-text").textContent = s.online ? "ONLINE" : "OFFLINE";
 document.getElementById("status-dot").className = "dot " + (s.online ? "online" : "");
 document.getElementById("cpu").textContent = s.cpu === null ? "—" : fmt(s.cpu)+"%";
 document.getElementById("memory").textContent =
  s.memory_percent === null ? "—" : fmt(s.memory_percent)+"%";
 document.getElementById("memory-detail").textContent =
  s.memory_used === null ? "Memory unavailable" :
  `${fmt(s.memory_used)} used · ${fmt(s.memory_free)} free bytes`;

 currentInterfaces = s.interfaces || [];
 const up = currentInterfaces.filter(i=>i.oper===1).length;
 document.getElementById("interface-count").textContent = currentInterfaces.length;
 document.getElementById("interface-state").textContent =
  `${up} UP · ${currentInterfaces.length-up} DOWN`;
 document.getElementById("uptime").textContent = uptime(s.uptime);
 document.getElementById("location").textContent = s.location || "Location not set";
 renderInterfaces();

 document.getElementById("vlan-rows").innerHTML = (s.vlans||[]).map(v=>
  `<tr><td>${esc(v.id)}</td><td>${esc(v.name)}</td></tr>`
 ).join("") || '<tr><td colspan="2" class="empty">No VLAN data</td></tr>';

 document.getElementById("mac-rows").innerHTML = (s.macs||[]).map(m=>
  `<tr><td>${esc(m.mac)}</td><td>${esc(m.port)}</td><td>${esc(m.interface)}</td><td>${m.status===3?'Learned':fmt(m.status)}</td></tr>`
 ).join("") || '<tr><td colspan="4" class="empty">No MAC entries</td></tr>';

 const info = [
  ["Hostname",s.name],["Address",s.host],["System description",s.sys_descr],
  ["System uptime",uptime(s.uptime)],["Location",s.location],
  ["Interface count",s.interface_count],["CPU average",s.cpu===null?"—":s.cpu+"%"],
  ["Memory used (bytes)",s.memory_used],["Memory free (bytes)",s.memory_free]
 ];
 document.getElementById("device-rows").innerHTML = info.map(([k,v])=>
  `<tr><th>${esc(k)}</th><td>${esc(v)}</td></tr>`).join("");

 document.getElementById("last-update").textContent =
  "Updated " + new Date().toLocaleTimeString();
}
async function refresh() {
 try {
  const response = await fetch(`/api/switch/${encodeURIComponent(SWITCH_ID)}`,
   {cache:"no-store"});
  if (!response.ok) throw new Error("HTTP " + response.status);
  const data = await response.json();
  render(data);
 } catch(e) {
  document.getElementById("status-text").textContent = "DATA UNAVAILABLE";
  document.getElementById("status-dot").className = "dot";
  document.getElementById("last-update").textContent = e.message;
 }
}
document.querySelectorAll(".tabs button").forEach(b=>b.addEventListener("click",()=>{
 document.querySelectorAll(".tabs button").forEach(x=>x.classList.remove("active"));
 document.querySelectorAll(".tab-content").forEach(x=>x.classList.add("hidden"));
 b.classList.add("active");
 document.getElementById(b.dataset.tab).classList.remove("hidden");
}));
document.getElementById("interface-search").addEventListener("input",renderInterfaces);
document.querySelectorAll("#switch-nav a").forEach(a=>{
 if(a.dataset.id===SWITCH_ID)a.classList.add("active");
});
refresh();
setInterval(refresh,REFRESH_MS);
</script>
</body>
</html>
