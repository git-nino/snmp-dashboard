import json
import re
import subprocess
import threading
import time
from pathlib import Path
from flask import Flask, jsonify, render_template

BASE = Path(__file__).resolve().parent
CONFIG = json.loads((BASE / "config.json").read_text())
app = Flask(__name__)

LOCK = threading.Lock()
CACHE = {}
PREVIOUS = {}
POLL_SECONDS = int(CONFIG.get("refresh_seconds", 5))

# Numeric OIDs: no MIB-name dependency
OIDS = {
    "sysDescr":       "1.3.6.1.2.1.1.1.0",
    "sysObjectID":    "1.3.6.1.2.1.1.2.0",
    "sysUpTime":      "1.3.6.1.2.1.1.3.0",
    "sysName":        "1.3.6.1.2.1.1.5.0",
    "sysLocation":    "1.3.6.1.2.1.1.6.0",
    "ifNumber":       "1.3.6.1.2.1.2.1.0",

    "ifDescr":        "1.3.6.1.2.1.2.2.1.2",
    "ifAdmin":        "1.3.6.1.2.1.2.2.1.7",
    "ifOper":         "1.3.6.1.2.1.2.2.1.8",
    "ifSpeed":        "1.3.6.1.2.1.2.2.1.5",
    "ifInErrors":     "1.3.6.1.2.1.2.2.1.14",
    "ifOutErrors":    "1.3.6.1.2.1.2.2.1.20",
    "ifInDiscards":   "1.3.6.1.2.1.2.2.1.13",
    "ifOutDiscards":  "1.3.6.1.2.1.2.2.1.19",

    "ifName":         "1.3.6.1.2.1.31.1.1.1.1",
    "ifAlias":        "1.3.6.1.2.1.31.1.1.1.18",
    "ifHighSpeed":    "1.3.6.1.2.1.31.1.1.1.15",
    "ifHCIn":         "1.3.6.1.2.1.31.1.1.1.6",
    "ifHCOut":        "1.3.6.1.2.1.31.1.1.1.10",

    "cpu":            "1.3.6.1.4.1.9.9.109.1.1.1.1.6",
    "memUsed":        "1.3.6.1.4.1.9.9.48.1.1.1.5",
    "memFree":        "1.3.6.1.4.1.9.9.48.1.1.1.6",

    "vlanName":       "1.3.6.1.2.1.17.7.1.4.3.1.1",
    "macPort":        "1.3.6.1.2.1.17.4.3.1.2",
    "macStatus":      "1.3.6.1.2.1.17.4.3.1.3",
    "bridgeIfIndex":  "1.3.6.1.2.1.17.1.4.1.2"
}

def parse_value(raw):
    raw = raw.strip()
    if ": " in raw:
        raw = raw.split(": ", 1)[1].strip()
    if raw.startswith('"') and raw.endswith('"'):
        return raw[1:-1]
    if re.fullmatch(r"-?\d+", raw):
        try:
            return int(raw)
        except ValueError:
            pass
    return raw

def walk(sw, oid):
    cmd = [
        "snmpwalk", "-v2c", "-c", sw["community"],
        "-t", "1", "-r", "0", "-On", sw["host"], oid
    ]
    try:
        result = subprocess.run(
            cmd, capture_output=True, text=True, timeout=3
        )
    except (subprocess.TimeoutExpired, OSError):
        return {}

    values = {}
    for line in result.stdout.splitlines():
        if " = " not in line:
            continue
        full_oid, raw = line.split(" = ", 1)
        full = full_oid.strip().lstrip(".")
        base = oid.lstrip(".")
        if full == base:
            suffix = "0"
        elif full.startswith(base + "."):
            suffix = full[len(base) + 1:]
        else:
            continue
        values[suffix] = parse_value(raw)
    return values

def number(value, default=0):
    if isinstance(value, int):
        return value
    if isinstance(value, str):
        match = re.search(r"-?\d+", value)
        if match:
            return int(match.group())
    return default

def mac_from_suffix(suffix):
    try:
        parts = [int(x) for x in suffix.split(".")]
        if len(parts) == 6:
            return ":".join(f"{x:02x}" for x in parts)
    except ValueError:
        pass
    return suffix

def poll_switch(sw):
    result = {
        "id": sw["id"], "name": sw["name"], "host": sw["host"],
        "online": False, "interfaces": [], "vlans": [], "macs": [],
        "cpu": None, "memory_used": None, "memory_free": None,
        "memory_percent": None, "uptime": "—", "sys_descr": "—",
        "location": "—", "interface_count": 0, "last_error": None
    }

    system = {key: walk(sw, oid) for key, oid in OIDS.items()
              if key in ("sysName", "sysDescr", "sysUpTime",
                         "sysLocation", "ifNumber")}
    name = system["sysName"].get("0")
    if name is None:
        result["last_error"] = "No SNMP response"
        return result

    result["online"] = True
    result["name"] = str(name)
    result["sys_descr"] = system["sysDescr"].get("0", "—")
    result["uptime"] = system["sysUpTime"].get("0", "—")
    result["location"] = system["sysLocation"].get("0", "—")
    result["interface_count"] = number(system["ifNumber"].get("0"))

    tables = {}
    for key in (
        "ifDescr", "ifName", "ifAlias", "ifAdmin", "ifOper",
        "ifSpeed", "ifHighSpeed", "ifHCIn", "ifHCOut",
        "ifInErrors", "ifOutErrors", "ifInDiscards", "ifOutDiscards",
        "cpu", "memUsed", "memFree", "vlanName", "macPort",
        "macStatus", "bridgeIfIndex"
    ):
        tables[key] = walk(sw, OIDS[key])

    now = time.monotonic()
    old = PREVIOUS.get(sw["id"], {})
    elapsed = max(now - old.get("time", now), 0.001)
    current = {}

    indexes = set(tables["ifDescr"]) | set(tables["ifName"])
    for idx in sorted(indexes, key=lambda x: int(x) if x.isdigit() else 999999):
        descr = tables["ifDescr"].get(idx, "")
        name = tables["ifName"].get(idx, descr or f"Interface {idx}")
        rx = number(tables["ifHCIn"].get(idx))
        tx = number(tables["ifHCOut"].get(idx))

        old_rx = old.get("counters", {}).get(idx, {}).get("rx")
        old_tx = old.get("counters", {}).get(idx, {}).get("tx")
        rx_mbps = max(0, (rx - old_rx) * 8 / elapsed / 1_000_000) if old_rx is not None and rx >= old_rx else 0
        tx_mbps = max(0, (tx - old_tx) * 8 / elapsed / 1_000_000) if old_tx is not None and tx >= old_tx else 0
        current[idx] = {"rx": rx, "tx": tx}

        speed = number(tables["ifHighSpeed"].get(idx))
        if speed == 0:
            speed = number(tables["ifSpeed"].get(idx)) // 1_000_000

        result["interfaces"].append({
            "index": idx,
            "name": str(name),
            "description": str(descr),
            "alias": str(tables["ifAlias"].get(idx, "")),
            "admin": number(tables["ifAdmin"].get(idx)),
            "oper": number(tables["ifOper"].get(idx)),
            "speed_mbps": speed,
            "rx_mbps": round(rx_mbps, 3),
            "tx_mbps": round(tx_mbps, 3),
            "rx_bytes": rx,
            "tx_bytes": tx,
            "in_errors": number(tables["ifInErrors"].get(idx)),
            "out_errors": number(tables["ifOutErrors"].get(idx)),
            "in_discards": number(tables["ifInDiscards"].get(idx)),
            "out_discards": number(tables["ifOutDiscards"].get(idx))
        })

    PREVIOUS[sw["id"]] = {"time": now, "counters": current}

    cpu_values = [number(v) for v in tables["cpu"].values()]
    if cpu_values:
        result["cpu"] = round(sum(cpu_values) / len(cpu_values), 1)

    used_values = [number(v) for v in tables["memUsed"].values()]
    free_values = [number(v) for v in tables["memFree"].values()]
    if used_values:
        result["memory_used"] = sum(used_values)
        result["memory_free"] = sum(free_values)
        total = result["memory_used"] + result["memory_free"]
        if total:
            result["memory_percent"] = round(result["memory_used"] * 100 / total, 1)

    for vlan_id, vlan_name in tables["vlanName"].items():
        result["vlans"].append({"id": vlan_id, "name": str(vlan_name)})

    bridge_to_if = {
        str(port): str(ifidx)
        for port, ifidx in tables["bridgeIfIndex"].items()
    }
    if_names = {x["index"]: x["name"] for x in result["interfaces"]}
    for suffix, port in tables["macPort"].items():
        status = number(tables["macStatus"].get(suffix))
        result["macs"].append({
            "mac": mac_from_suffix(suffix),
            "port": str(port),
            "interface": if_names.get(bridge_to_if.get(str(port), ""), "Unknown"),
            "status": status
        })

    result["vlans"].sort(key=lambda x: number(x["id"]))
    result["macs"].sort(key=lambda x: x["mac"])
    return result

def poll_loop():
    while True:
        for sw in CONFIG["switches"]:
            try:
                data = poll_switch(sw)
            except Exception as exc:
                data = {
                    "id": sw["id"], "name": sw["name"], "host": sw["host"],
                    "online": False, "interfaces": [], "vlans": [], "macs": [],
                    "cpu": None, "memory_used": None, "memory_free": None,
                    "memory_percent": None, "uptime": "—", "sys_descr": "—",
                    "location": "—", "interface_count": 0,
                    "last_error": str(exc)
                }
            with LOCK:
                CACHE[sw["id"]] = data
        time.sleep(POLL_SECONDS)

@app.get("/")
def index():
    return render_template("index.html", refresh=POLL_SECONDS)

@app.get("/api/data")
def api_data():
    with LOCK:
        return jsonify({
            "refresh_seconds": POLL_SECONDS,
            "switches": list(CACHE.values())
        })

@app.get("/health")
def health():
    return jsonify({"status": "ok"})

if __name__ == "__main__":
    threading.Thread(target=poll_loop, daemon=True).start()
    app.run(host="0.0.0.0", port=5000, debug=False)
